PROJECT_NAME="Atulyam Luxury Restaurant API"
API_V1_STR="/api/v1"
SECRET_KEY="supersecret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MySQL Database Connection URL:
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="mysql+pymysql://root:password@localhost:3306/atulyam_db"

# Fallback to SQLite if MySQL is offline during development:
SQLITE_DEV_FALLBACK=True

# CORS Origins (comma-separated or array)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
